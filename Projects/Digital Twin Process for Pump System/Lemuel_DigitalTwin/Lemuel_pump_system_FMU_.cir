       <VISIBILITY>False</VISIBILITY>
       <DEF_VALUE>$AME/libthh/data_advanced/</DEF_VALUE>
       <VALUE>$AME/libthh/data_advanced/</VALUE>
       <TEXT_TYPE>3</TEXT_TYPE>
      </TPARAM>
