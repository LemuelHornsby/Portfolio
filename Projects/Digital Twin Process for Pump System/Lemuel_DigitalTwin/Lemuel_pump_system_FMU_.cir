      <TPARAM>
       <SUB_ID>18</SUB_ID>
       <TITLE>name of simple fluid</TITLE>
       <CUSTOM_TITLE>name of simple fluid</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>545</CIRCUIT_SCOPE_ID>
       <VARNAME>fluidnameTFFD1</VARNAME>
       <VISIBILITY>(ftype == 1)</VISIBILITY>
       <DEF_VALUE>water</DEF_VALUE>
       <VALUE>water</VALUE>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>12</SUB_ID>
       <TITLE>name of advanced fluid</TITLE>
       <CUSTOM_TITLE>name of advanced fluid</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>546</CIRCUIT_SCOPE_ID>
       <VARNAME>fluidnameTFFD2</VARNAME>
       <VISIBILITY>(ftype == 2)</VISIBILITY>
       <DEF_VALUE>diesel80_rme20</DEF_VALUE>
       <VALUE>diesel80_rme20</VALUE>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>19</SUB_ID>
       <TITLE>filename for simple fluid characteristic data</TITLE>
       <CUSTOM_TITLE>filename for simple fluid characteristic data</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>547</CIRCUIT_SCOPE_ID>
       <VARNAME>charfileTFFD1</VARNAME>
       <VISIBILITY>(ftype == 1)</VISIBILITY>
       <DEF_VALUE>$AME/libthh/data/water.data</DEF_VALUE>
       <VALUE>$AME/libthh/data/water.data</VALUE>
       <HIDDEN>2</HIDDEN>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>13</SUB_ID>
       <TITLE>filename for advanced fluid characteristic data</TITLE>
       <CUSTOM_TITLE>filename for advanced fluid characteristic data</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>548</CIRCUIT_SCOPE_ID>
       <VARNAME>charfileTFFD2</VARNAME>
       <VISIBILITY>(ftype == 2)</VISIBILITY>
       <DEF_VALUE>$AME/libthh/data_advanced/diesel80_rme20.data</DEF_VALUE>
       <VALUE>$AME/libthh/data_advanced/diesel80_rme20.data</VALUE>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>24</SUB_ID>
       <TITLE>filename or expression for high saturated vapor pressure in cavitation[barA] = f(T[degC])</TITLE>
       <CUSTOM_TITLE>filename or expression for high saturated vapor pressure in cavitation[barA] = f(T[degC])</CUSTOM_TITLE>
       <ORIG_TITLE>high saturated vapor pressure (cavitation) - filename or expression Pvaph[barA] = f(T[degC])</ORIG_TITLE>
       <CIRCUIT_SCOPE_ID>549</CIRCUIT_SCOPE_ID>
       <VARNAME>pvaph2T</VARNAME>
       <VISIBILITY>(cavtype == 4)</VISIBILITY>
       <DEF_VALUE>10^(6.20963-2354.731/(280.709+T))+0.02</DEF_VALUE>
       <VALUE>10^(6.20963-2354.731/(280.709+T))+0.02</VALUE>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>25</SUB_ID>
       <TITLE>filename or expression for low saturated vapor pressure in cavitation[barA] = f(T[degC])</TITLE>
       <CUSTOM_TITLE>filename or expression for low saturated vapor pressure in cavitation[barA] = f(T[degC])</CUSTOM_TITLE>
       <ORIG_TITLE>low saturated vapor pressure (cavitation) - filename or expression Pvapl[barA] = f(T[degC])</ORIG_TITLE>
       <CIRCUIT_SCOPE_ID>550</CIRCUIT_SCOPE_ID>
       <VARNAME>pvapl2T</VARNAME>
       <VISIBILITY>(cavtype == 4)</VISIBILITY>
       <DEF_VALUE>10^(6.20963-2354.731/(280.709+T))</DEF_VALUE>
       <VALUE>10^(6.20963-2354.731/(280.709+T))</VALUE>
       <TEXT_TYPE>0</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
       <SUB_ID>69</SUB_ID>
       <TITLE>expression for gas release rate[1/s] = f(p[barA], psat[barA], xu, xueq, T[degC])</TITLE>
       <CUSTOM_TITLE>expression for gas release rate[1/s] = f(p[barA], psat[barA], xu, xueq, T[degC])</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>551</CIRCUIT_SCOPE_ID>
       <VARNAME>dynaeration</VARNAME>
       <VISIBILITY>(cavtype>2)&&(aeropt>2)&&(dynaeradiss==2)</VISIBILITY>
       <DEF_VALUE>2000*(xueq-xu)*sqrt(fabs(psat-p))</DEF_VALUE>
       <VALUE>2000*(xueq-xu)*sqrt(fabs(psat-p))</VALUE>
       <TEXT_TYPE>2</TEXT_TYPE>
       <TOKEN_LIST>p, psat, xu, xueq, T</TOKEN_LIST>
      </TPARAM>
      <TPARAM>
       <SUB_ID>70</SUB_ID>
       <TITLE>expression for gas dissolution rate[1/s] = f(p[barA], psat[barA], xu, xueq, T[degC])</TITLE>
       <CUSTOM_TITLE>expression for gas dissolution rate[1/s] = f(p[barA], psat[barA], xu, xueq, T[degC])</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>552</CIRCUIT_SCOPE_ID>
       <VARNAME>dyndissolution</VARNAME>
       <VISIBILITY>(cavtype>2)&&(aeropt>2)&&(dynaeradiss==2)</VISIBILITY>
       <DEF_VALUE>-0.1*xu*sqrt(fabs(p-psat))</DEF_VALUE>
       <VALUE>-0.1*xu*sqrt(fabs(p-psat))</VALUE>
       <TEXT_TYPE>2</TEXT_TYPE>
       <TOKEN_LIST>p, psat, xu, xueq, T</TOKEN_LIST>
      </TPARAM>
      <TPARAM>
       <SUB_ID>75</SUB_ID>
       <TITLE>dataSimple</TITLE>
       <CUSTOM_TITLE>dataSimple</CUSTOM_TITLE>
       <CIRCUIT_SCOPE_ID>553</CIRCUIT_SCOPE_ID>
       <VARNAME>dataSimple</VARNAME>
       <VISIBILITY>False</VISIBILITY>
       <DEF_VALUE>$AME/libthh/data/</DEF_VALUE>
       <VALUE>$AME/libthh/data/</VALUE>
       <TEXT_TYPE>3</TEXT_TYPE>
      </TPARAM>
      <TPARAM>
