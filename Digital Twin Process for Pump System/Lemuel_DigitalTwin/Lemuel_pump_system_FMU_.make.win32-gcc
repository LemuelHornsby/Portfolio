#
# Simcenter Amesim system make file
#


# This makefile has been created using the following cathegory path list
#	$AME
#	$AME/libsig
#	$AME/libmec
#	$AME/libhydr
#	$AME/libpn
#	$AME/libth
#	$AME/libemd
#	$AME/libesc
#	$AME/libeb
#	$AME/libmotion
#	$AME/libthh
# End category path list
# The MACHINETYPE variable can be used in -L statements
# or otherwise to separate machine dependent code

MACHINETYPE = win32-gcc

# Then the object files
OBJECTS = \
	c:/program\ files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFFD3.o \
	c:/program\ files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFTK0.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/UD00.o \
	c:/program\ files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFVORF0.o \
	c:/program\ files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFVF000.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/CTRPID0.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/CONS00.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SSINK.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SIGRECEI0.o \
	c:/program\ files/simcenter/2404/amesim/libmec/submodels/win32-gcc/PMV00.o \
	c:/program\ files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SIGTRANS0.o \
	c:/program\ files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFPUC0.o \
	C:/Program\ Files/Simcenter/2404/Amesim/submodels/win32-gcc/INTVARSENSOR0.o

OBJECTS2 = \
	"c:/program files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFFD3.o" \
	"c:/program files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFTK0.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/UD00.o" \
	"c:/program files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFVORF0.o" \
	"c:/program files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFVF000.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/CTRPID0.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/CONS00.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SSINK.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SIGRECEI0.o" \
	"c:/program files/simcenter/2404/amesim/libmec/submodels/win32-gcc/PMV00.o" \
	"c:/program files/simcenter/2404/amesim/libsig/submodels/win32-gcc/SIGTRANS0.o" \
	"c:/program files/simcenter/2404/amesim/libthh/submodels/win32-gcc/TFPUC0.o" \
	"C:/Program Files/Simcenter/2404/Amesim/submodels/win32-gcc/INTVARSENSOR0.o"

Lemuel_pump_system_FMU_.dll: $(OBJECTS) Lemuel_pump_system_FMU_.o
	$(CC) -m32 -Wl,-E -shared $(LDFLAGS) -o Lemuel_pump_system_FMU_.dll Lemuel_pump_system_FMU_.o $(OBJECTS2) \
	-L"C:/Program Files/Simcenter/2404/Amesim/libsig/lib/$(MACHINETYPE)" -lSIG -L"C:/Program Files/Simcenter/2404/Amesim/libmec/lib/$(MACHINETYPE)" -lMEC -L"C:/Program Files/Simcenter/2404/Amesim/libhydr/lib/$(MACHINETYPE)" -lHYDR -L"$(AME)/libth/lib/$(MACHINETYPE)" -lTH -L"C:/Program Files/Simcenter/2404/Amesim/libpn/lib/$(MACHINETYPE)" -lPN -L"C:/Program Files/Simcenter/2404/Amesim/libth/lib/$(MACHINETYPE)" -lTH -L"C:/Program Files/Simcenter/2404/Amesim/libemd/lib/$(MACHINETYPE)" -lEMD $(FLUX_MP_LIB) -L"C:/Program Files/Simcenter/2404/Amesim/libesc/lib/$(MACHINETYPE)" -lESC -L"C:/Program Files/Simcenter/2404/Amesim/libeb/lib/$(MACHINETYPE)" -lEB -L"C:/Program Files/Simcenter/2404/Amesim/libmotion/lib/$(MACHINETYPE)" -lAMEMOTION -L"$(AME)/libth/lib/$(MACHINETYPE)" -lTH -L"$(AME)/libcfd1d/lib/$(MACHINETYPE)" -lCFD1D -Wl,-Bstatic,-lpthread,-Bdynamic -L"$(AME)/libpn/lib/$(MACHINETYPE)" -lPN -L"$(AME)/libeng/lib/$(MACHINETYPE)" -lENG -L"$(AME)/libexh/lib/$(MACHINETYPE)" -lEXH -L"$(AME)/libhydr/lib/$(MACHINETYPE)" -lHYDR -L"C:/Program Files/Simcenter/2404/Amesim/libthh/lib/$(MACHINETYPE)" -lTHH -Wl,-Bstatic,-lstdc++,-Bdynamic  \
	$(AMELIBS)

Lemuel_pump_system_FMU_.o: Lemuel_pump_system_FMU_.c
	$(CC) -c -m32 -I"$(AME)\interfaces\fmi" -I"$(AME)\interfaces" -I"$(AME)\interfaces\user_cosim" $(CFLAGS) -o Lemuel_pump_system_FMU_.o Lemuel_pump_system_FMU_.c

.c.o:
	@echo
	@echo "Warning: \"$<\" is newer than the object."
	@echo ""

.f.o:
	@echo
	@echo "Warning: \"$<\" is newer than the object."
	@echo ""

